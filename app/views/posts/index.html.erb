<h2>スケジュール管理APP</h2>
<tr>
  <td>
    <%= link_to "新規登録", new_post_path %>
  </td>
</tr>
<table>
  <tr>
    <th>タイトル</th><th>開始日</th><th>終了日</th><th>終日</th><th>更新日時</th>
  </tr>
  <% @posts.each do |post| %>
    <tr>
      <td>
        <%= post.title %>
      </td>
      <td>
        <%= post.start_date %>
      </td>
      <td>
        <%= post.end_date %>
      </td>
      <% if post.all_day %>
        <td>終日</td>
      <% else %>
        <td></td>
      <% end %>
      <td>
        <%= post.updated_at %>
      </td>
      <td>
        <%= link_to "詳細", post %>
      </td>
      <td>
        <%= link_to "編集", edit_post_path(post) %>
      </td>
      <td>
        <%= link_to "削除", post, data: {turbo_method: :delete, turbo_confirm: "予定を削除しますか？"} %>
      </td>
    </tr>
  <% end %>
</table>