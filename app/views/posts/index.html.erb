<div class="row">
  <div class="col-xs-8">
    <h3>スケジュール一覧</h3>
  </div>
  <div class="col-xs-4 text-right">
    <%= link_to "新規登録", new_post_path, class: "btn btn-primary" %>
  </div>
</div>
<table class="table">
  <tr>
    <th>ID</th><th>タイトル</th><th>開始日</th><th>終了日</th><th>終日</th><th>更新日時</th>
  </tr>
  <% @posts.each do |post| %>
    <tr>
      <td>
        <%= post.id %>
      </td>
      <td>
        <%= post.title %>
      </td>
      <td>
        <%= post.start_date %>
      </td>
      <td>
        <%= post.end_date %>
      </td>
      <% if post.all_day %>
        <td>終日</td>
      <% else %>
        <td></td>
      <% end %>
      <td>
        <%= l post.updated_at %>
      </td>
      <td>
        <%= link_to "詳細", post, class:"btn btn-info" %>
      </td>
      <td>
        <%= link_to "編集", edit_post_path(post), class:"btn btn-secondary" %>
      </td>
      <td>
        <%= link_to "削除", post, data: {turbo_method: :delete, turbo_confirm: "予定を削除しますか？"}, class:"btn btn-danger" %>
      </td>
    </tr>
  <% end %>
</table>
<div class="row">
  <div class="col-xs-6">
    <h2>予定合計 <%= @counts %> 件</h2>
  </div>
  <div class="col-xs-6 text-right">
    <h3> 本日の日付 <%= Date.today %></h3>
  </div>
</div>