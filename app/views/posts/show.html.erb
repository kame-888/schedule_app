<span><%= current_post.title %></span>
<%= link_to "編集", edit_post_path(@user) %>
<%= link_to "一覧へ戻る", posts_path %>
<%= link_to "削除", @post, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" } %>
<dl>
  <dt>title</dt>       <dd><%= @post.title %></dd>
  <dt>内容</dt>     <dd><%= @post.body %></dd>
  <dt>開始日</dt>       <dd><%= @post.start_date %></dd>
  <dt>終了日</dt> <dd><%= @post.end_date %></dd>
</dl>